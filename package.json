{
  "name": "rtcalc",
  "version": "1.0.5",
  "description": "Scientific Roller Tape Calculator",
  "author": "Pablo Niklas <pablo.niklas@gmail.com> (https://github.com/pabloniklas)",
  "main": "main.js",
  "desktopName": "rtcalc.desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --linux --win"
  },
  "build": {
    "appId": "com.pabloniklas.rtcalc",
    "productName": "RTCalc",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "main.js",
      "package.json"
    ],
    "linux": {
      "category": "Utility;Education;",
      "icon": "assets/icon.png",
      "executableName": "rtcalc",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "deb": {
      "priority": "optional"
    },
    "rpm": {
      "fpm": [
        "--rpm-os",
        "linux"
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "algebrite": "^1.4.0",
    "mathjs": "^13.0.0",
    "plotly.js-dist-min": "^2.35.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
